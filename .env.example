# Required. Use the postgres service hostname when running in Compose.
# Compose backup accepts postgres://USER:PASSWORD@HOST:PORT/DATABASE without URI options.
# Keep the URL-safe password generated by scripts/init-env.sh; external databases are not supported.
DATABASE_URL=
# Required, at least 32 bytes. Generate a unique random value locally.
KATWORK_SECRET=
# Required by the Compose postgres service; match the password in DATABASE_URL.
POSTGRES_PASSWORD=
# Set to 1 to enable keyless demo mode and permit seed-demo.
KATWORK_DEMO=
# Absolute HTTP(S) origin, no path prefix/query/credentials. Defaults to http://localhost:3000.
# HTTPS enables Secure session cookies; HTTP logs a startup warning. Required with SMTP_HOST,
# and used for the links create-user and reset-link print.
KATWORK_PUBLIC_URL=
# Set to exactly 1 to permit demo mode on HTTPS; leave unset for production.
KATWORK_ALLOW_DEMO_ON_HTTPS=
# Comma-separated IPv4/IPv6 CIDRs (10.0.0.0/8) or bare IPs (172.31.250.2, meaning /32 or /128).
# Empty trusts no X-Forwarded-For headers. Include only proxies that append or overwrite
# X-Forwarded-For. A trusted proxy is exempt from the per-peer connection cap below.
KATWORK_TRUSTED_PROXIES=
# HTTP/1 header deadline, including idle keep-alive. Positive seconds; default 10.
KATWORK_HEADER_TIMEOUT_SECONDS=
# Maximum connection I/O inactivity. HTTP/1 closes at the earlier header deadline. Default 60.
KATWORK_IDLE_TIMEOUT_SECONDS=
# Open TCP connection caps. Positive integers; defaults 256 globally and 32 per peer IP (/64 for IPv6).
# An untrusted proxy's connections share its socket-peer budget; a trusted proxy counts only toward
# the global cap, so enforce client connection limits at the proxy too.
KATWORK_MAX_CONNECTIONS=
KATWORK_MAX_CONNECTIONS_PER_IP=
# Optional; at least 8 characters. Otherwise seed-demo prints a random initial password.
# seed-demo --reset-password prints the replacement password and revokes existing credentials.
KATWORK_DEMO_PASSWORD=
# Compose binds localhost by default. Set KATWORK_BIND=0.0.0.0 for LAN access, and then
# KATWORK_PUBLIC_URL=http://<this host's LAN address>:3000 too: otherwise other machines get
# host_not_allowed and printed links point at localhost. serve warns about that combination.
KATWORK_BIND=
# SMTP hostname without credentials; needs KATWORK_PUBLIC_URL. Unset disables mail except
# demo@katwork.local in demo mode; without SMTP, create-user and reset-link print set-password links.
SMTP_HOST=
# Default 587 (required STARTTLS); 465 uses implicit TLS. Certificates are verified.
SMTP_PORT=
SMTP_USERNAME=
# Optional; at least 8 characters when set. Configure SMTP_USERNAME with SMTP_PASSWORD.
SMTP_PASSWORD=
# Defaults to noreply@katwork.local; use a sender accepted by your SMTP relay.
SMTP_FROM=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Positive milliseconds; defaults to 5000.
KATWORK_LOCK_TIMEOUT_MS=
# Threads that parse documents, 1 to 16; default 2. One workspace uses at most all but one.
KATWORK_DOC_WORKERS=
# XML elements one document may hold across its parts, 1000 to 20000000; default 2000000.
# A document over it is refused (file_too_complex) before the reader builds anything from it.
KATWORK_DOC_MAX_XML_ELEMENTS=
# Compose memory limit for the katwork container (for example 4g, the default). Each document
# thread holds the file (up to 25 MiB), what it inflates (up to 200 MiB) and the reader's model,
# about 150 bytes per XML element at most: measured peaks were about 300 MB per thread at the
# default element cap and about 520 MB for one paragraph of 190 MB of text. Allow 1 GiB per
# thread on top of the server's own memory when you raise either setting.
KATWORK_MEMORY_LIMIT=

# Optional local OpenAI-compatible Chat Completions server. Set URL and model together.
# From Compose to a server on the Docker host: http://host.docker.internal:<port>/v1,
# never localhost (which names the container). Ollama: 11434; vLLM: 8000;
# llama.cpp: 8080 (set --port 8080 explicitly; defaults vary across releases).
# On another machine, use its LAN hostname/IP; Ollama needs OLLAMA_HOST=0.0.0.0.
# The server must listen on an interface reachable from the container.
# On a Linux Docker host, Ollama on the same host listens on 127.0.0.1: set OLLAMA_HOST to
# the Docker bridge address (e.g. 172.17.0.1), or 0.0.0.0 behind a firewall. A default-deny
# firewall such as ufw must allow the Compose subnet to reach 172.17.0.1 port 11434.
# Ollama has no authentication; anyone who can reach its port can use it.
# No query, fragment or username/password in the URL. One model serves all tiers.
# This declares Local residency; a remote URL receives local-only Space data too.
# Local providers ignore proxy environment variables.
# Ollama can silently truncate prompts: raise model num_ctx or OLLAMA_CONTEXT_LENGTH.
# vLLM --max-model-len must fit the prompt + 8,192 Strong-tier output tokens, or HTTP 400.
KATWORK_LOCAL_BASE_URL=
KATWORK_LOCAL_MODEL=
# Optional. Unset sends no Authorization header.
KATWORK_LOCAL_API_KEY=

# Optional HTTPS hostname. scripts/init-env.sh --https sets the Compose override too.
KATWORK_HTTPS_HOST=
